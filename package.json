{
  "name": "communityfund",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Fund, contribution and collection management for community organizations",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "dev:backend": "convex dev",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --noEmit",
    "convex:push": "convex dev --once",
    "convex:seed": "node scripts/seed-demo.mjs",
    "convex:reset": "node scripts/reset-demo.mjs",
    "seed:reset": "node scripts/reset-demo.mjs",
    "seed:history": "node scripts/seed-history.mjs",
    "seed:fresh": "node scripts/refresh-demo.mjs",
    "smoke": "node scripts/smoke-queries.mjs",
    "check": "node scripts/check-security.mjs",
    "measure": "node scripts/measure-payload.mjs",
    "visual": "node scripts/visual-check.mjs",
    "visual:portal": "node scripts/visual-portal.mjs",
    "visual:signup": "node scripts/visual-signup.mjs",
    "visual:import": "node scripts/visual-import.mjs",
    "visual:ui": "node scripts/visual-ui.mjs",
    "visual:recovery": "node scripts/prove-recovery.mjs",
    "icons": "node scripts/make-icons.mjs",
    "balances:backfill": "node scripts/backfill-bank-years.mjs",
    "sql:schema": "node scripts/gen-sql-schema.mjs",
    "sql:check": "node scripts/check-sql-schema.mjs",
    "sql:invariants": "node scripts/check-sql-invariants.mjs",
    "portability": "node scripts/check-portable-domain.mjs",
    "port": "node scripts/check-sql-schema.mjs && node scripts/check-sql-invariants.mjs && node scripts/check-portable-domain.mjs"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.95",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.17.0",
    "lucide-react": "^0.469.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.63.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
